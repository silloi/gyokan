  "sentences": [
    {
      "id": "s1",
      "blockId": "b1",
      "blockKind": "heading",
      "text": "転入届（ほかの市区町村からの引っ越し）"
    },
    {
      "id": "s2",
      "blockId": "b2",
      "blockKind": "paragraph",
      "text": "他の市区町村からかもめ区に引っ越してきたときは、転入届の提出が必要です。"
    },
    {
      "id": "s3",
      "blockId": "b2",
      "blockKind": "paragraph",
      "text": "新しい住所に住み始めた日から14日以内に届け出てください。"
    },
    {
      "id": "s4",
      "blockId": "b3",
      "blockKind": "paragraph",
      "text": "正当な理由なく届出が遅れた場合は、過料が科されることがありますので、ご注意ください。"
    },
    {
      "id": "s5",
      "blockId": "b4",
      "blockKind": "heading",
      "text": "届出の期間"
    },
    {
      "id": "s6",
      "blockId": "b5",
      "blockKind": "paragraph",
      "text": "新しい住所に住み始めた日から14日以内（引っ越しの前には届け出ることができません）"
    },
    {
      "id": "s7",
      "blockId": "b6",
      "blockKind": "heading",
      "text": "届出ができる人"
    },
    {
      "id": "s8",
      "blockId": "b7",
      "blockKind": "paragraph",
      "text": "本人又は同じ世帯の方が届け出てください。"
    },
    {
      "id": "s9",
      "blockId": "b7",
      "blockKind": "paragraph",
      "text": "それ以外の方が届け出る場合は、委任状が必要です。"
    },
    {
      "id": "s10",
      "blockId": "b8",
      "blockKind": "paragraph",
      "text": "原則として、委任状は本人が自署したものに限ります。"
    },
    {
      "id": "s11",
      "blockId": "b9",
      "blockKind": "heading",
      "text": "届出に必要なもの"
    },
    {
      "id": "s12",
      "blockId": "b10",
      "blockKind": "list-item",
      "text": "転出証明書（前の住所の市区町村で転出届を出したときに交付されたもの）"
    },
    {
      "id": "s13",
      "blockId": "b10",
      "blockKind": "list-item",
      "text": "※マイナンバーカードを利用して転出届をした方は不要です。"
    },
    {
      "id": "s14",
      "blockId": "b11",
      "blockKind": "list-item",
      "text": "届出に来られる方の本人確認書類（マイナンバーカード、運転免許証、在留カードなど）"
    },
    {
      "id": "s15",
      "blockId": "b12",
      "blockKind": "list-item",
      "text": "転入される方全員のマイナンバーカード（お持ちの方のみ）"
    },
    {
      "id": "s16",
      "blockId": "b13",
      "blockKind": "list-item",
      "text": "代理人が届け出る場合は、委任状"
    },
    {
      "id": "s17",
      "blockId": "b14",
      "blockKind": "paragraph",
      "text": "外国籍の方は、転入される方全員の在留カード又は特別永住者証明書をお持ちください。"
    },
    {
      "id": "s18",
      "blockId": "b15",
      "blockKind": "paragraph",
      "text": "必要に応じて、ほかの書類の提示をお願いすることがあります。"
    },
    {
      "id": "s19",
      "blockId": "b16",
      "blockKind": "heading",
      "text": "届出の場所と受付時間"
    },
    {
      "id": "s20",
      "blockId": "b17",
      "blockKind": "table-cell",
      "text": "届出の場所"
    },
    {
      "id": "s21",
      "blockId": "b18",
      "blockKind": "table-cell",
      "text": "かもめ区役所 本庁舎2階 区民課 住民記録係"
    },
    {
      "id": "s22",
      "blockId": "b18",
      "blockKind": "table-cell",
      "text": "各出張所でも受け付けています。"
    },
    {
      "id": "s23",
      "blockId": "b18",
      "blockKind": "table-cell",
      "text": "ただし、一部の手続きは本庁舎のみの取扱いとなります。"
    },
    {
      "id": "s24",
      "blockId": "b19",
      "blockKind": "table-cell",
      "text": "受付時間"
    },
    {
      "id": "s25",
      "blockId": "b20",
      "blockKind": "table-cell",
      "text": "平日 午前8時30分から午後5時まで（土曜日・日曜日・祝日・年末年始を除く）"
    },
    {
      "id": "s26",
      "blockId": "b21",
      "blockKind": "paragraph",
      "text": "毎月第2・第4土曜日の午前9時から正午まで、本庁舎で休日窓口を開設しています。"
    },
    {
      "id": "s27",
      "blockId": "b21",
      "blockKind": "paragraph",
      "text": "ただし、他の自治体への確認が必要な手続きは、後日改めてお越しいただく場合があります。"
    },
    {
      "id": "s28",
      "blockId": "b22",
      "blockKind": "heading",
      "text": "ご注意ください"
    },
    {
      "id": "s29",
      "blockId": "b23",
      "blockKind": "list-item",
      "text": "3月下旬から4月上旬は窓口が大変混雑し、長時間お待ちいただくことがあります。"
    },
    {
      "id": "s30",
      "blockId": "b23",
      "blockKind": "list-item",
      "text": "お手続きはお早めにお済ませください。"
    },
    {
      "id": "s31",
      "blockId": "b24",
      "blockKind": "list-item",
      "text": "受付終了時刻間際のご来庁はご遠慮ください。"
    },
    {
      "id": "s32",
      "blockId": "b25",
      "blockKind": "list-item",
      "text": "マイナンバーカードをお持ちの方は、転入届と同時にカードの住所変更の手続きを行ってください。"
    },
    {
      "id": "s33",
      "blockId": "b25",
      "blockKind": "list-item",
      "text": "手続きをしないと、カードが使えなくなることがあります。"
    },
    {
      "id": "s34",
      "blockId": "b26",
      "blockKind": "heading",
      "text": "あわせて必要な手続き"
    },
    {
      "id": "s35",
      "blockId": "b27",
      "blockKind": "paragraph",
      "text": "転入届の手続きの後、該当する方は次の手続きも行ってください。"
    },
    {
      "id": "s36",
      "blockId": "b28",
      "blockKind": "list-item",
      "text": "国民健康保険（勤務先の健康保険に加入していない方）"
    },
    {
      "id": "s37",
      "blockId": "b29",
      "blockKind": "list-item",
      "text": "国民年金（20歳以上60歳未満で、厚生年金に加入していない方）"
    },
    {
      "id": "s38",
      "blockId": "b30",
      "blockKind": "list-item",
      "text": "児童手当（お子さんを養育している方）"
    },
    {
      "id": "s39",
      "blockId": "b31",
      "blockKind": "list-item",
      "text": "小学校・中学校の転入学（お子さんがいる方）"
    },
    {
      "id": "s40",
      "blockId": "b32",
      "blockKind": "list-item",
      "text": "印鑑登録（必要な方のみ）"
    },
    {
      "id": "s41",
      "blockId": "b33",
      "blockKind": "heading",
      "text": "お問い合わせ"
    },
    {
      "id": "s42",
      "blockId": "b34",
      "blockKind": "paragraph",
      "text": "区民部 区民課 住民記録係"
    },
    {
      "id": "s43",
      "blockId": "b34",
      "blockKind": "paragraph",
      "text": "電話番号：000-000-0000"
    }
  ],
